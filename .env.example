NODE_ENV=development
PORT=8787
TRUST_PROXY_HOPS=0
MCP_RESOURCE_URL=http://127.0.0.1:8787/mcp
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
COOKIE_SIGNING_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://synapse_runtime:replace@host:5432/postgres
DATABASE_ADMIN_URL=postgresql://postgres:replace@host:5432/postgres
DATABASE_SSL=disable
# Production: set DATABASE_SSL=verify-full and paste the Supabase CA PEM here.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
ALLOW_DEV_TOKENS=true
PUBLIC_SIGNUP_ENABLED=false

# Separate organizer worker service only. It never uses DATABASE_URL or admin credentials.
MEMORY_PROCESSING_ENABLED=false
# DATABASE_WORKER_URL=postgresql://synapse_memory_worker:replace@host:5432/postgres
# OPENAI_API_KEY=replace-in-worker-environment-only
# MEMORY_MODEL=<explicit-model>
# MEMORY_REVIEW_MODEL=<explicit-review-model-or-omit-to-match>
MEMORY_MAX_STAGE_CALLS=2
MEMORY_REQUEST_TIMEOUT_MS=60000
MEMORY_MAX_OUTPUT_TOKENS=8000
MEMORY_POLL_INTERVAL_MS=2000

# All database URLs must omit sslmode/sslcert/sslkey/sslrootcert/ssl query options.
# DATABASE_SSL and DATABASE_CA_CERT above are the single TLS configuration source.

# Operator CLI only. Never configure this in the hosted MCP service.
SUPABASE_SECRET_KEY=sb_secret_replace_me
