NODE_ENV=development
PORT=8787
MCP_RESOURCE_URL=http://127.0.0.1:8787/mcp
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
COOKIE_SIGNING_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://synapse_runtime:replace@host:5432/postgres
DATABASE_ADMIN_URL=postgresql://postgres:replace@host:5432/postgres
DATABASE_SSL=disable
# Production: set DATABASE_SSL=verify-full and paste the Supabase CA PEM here.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
ALLOW_DEV_TOKENS=true

# Operator CLI only. Never configure this in the hosted MCP service.
SUPABASE_SECRET_KEY=sb_secret_replace_me
