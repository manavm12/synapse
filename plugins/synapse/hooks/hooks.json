{
  "description": "Route Synapse messages while capturing durable session memory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/bind-child.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run-node.ps1\" \"${PLUGIN_ROOT}/hooks/bind-child.mjs\"",
            "timeout": 15,
            "async": true,
            "statusMessage": "Binding Synapse child task"
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/compact-memory.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run-node.ps1\" \"${PLUGIN_ROOT}/hooks/compact-memory.mjs\"",
            "timeout": 10,
            "statusMessage": "Preparing Synapse memory checkpoint"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/conversation.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/wake-receiver.mjs\"",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run-dispatch.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run-node.ps1\" \"${PLUGIN_ROOT}/hooks/dispatch.mjs\"",
            "timeout": 30,
            "async": true,
            "statusMessage": "Routing Synapse task"
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/prompt-memory.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run-node.ps1\" \"${PLUGIN_ROOT}/hooks/prompt-memory.mjs\"",
            "timeout": 10,
            "statusMessage": "Saving Synapse memory"
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/offer-setup.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run-node.ps1\" \"${PLUGIN_ROOT}/hooks/offer-setup.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking Synapse setup"
          },
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/conversation.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/wake-receiver.mjs\"",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/checkpoint-memory.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run-node.ps1\" \"${PLUGIN_ROOT}/hooks/checkpoint-memory.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking Synapse memory checkpoint"
          },
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/conversation.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__synapse[-_]memory__(send_message|reply_to_message)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/conversation.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__synapse[-_]memory__(send_message|reply_to_message)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/conversation.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/conversation.mjs\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
