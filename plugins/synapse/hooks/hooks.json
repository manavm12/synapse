{
  "description": "Route Synapse messages while capturing durable session memory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/bind-child.mjs",
            "timeout": 15,
            "async": true,
            "statusMessage": "Binding Synapse child task"
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/compact-memory.mjs",
            "timeout": 10,
            "statusMessage": "Preparing Synapse memory checkpoint"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh ${PLUGIN_ROOT}/hooks/run-dispatch.sh",
            "timeout": 30,
            "async": true,
            "statusMessage": "Routing Synapse task"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/checkpoint-memory.mjs",
            "timeout": 10,
            "statusMessage": "Checking Synapse memory checkpoint"
          }
        ]
      }
    ]
  }
}
