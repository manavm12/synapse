{
  "description": "Route Synapse messages and capture durable session memory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/compact-memory.mjs",
            "timeout": 10,
            "statusMessage": "Preparing Synapse memory checkpoint"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/dispatch.mjs",
            "timeout": 10,
            "statusMessage": "Checking Synapse inbox"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "synapse-memory",
            "tool": "memory_checkpoint",
            "input": {
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "cwd": "${cwd}",
              "stop_hook_active": "${stop_hook_active}"
            },
            "timeout": 10,
            "statusMessage": "Checking Synapse memory checkpoint"
          }
        ]
      }
    ]
  }
}
