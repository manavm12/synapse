{
  "description": "Route one queued Synapse message on the next project prompt.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/dispatch.mjs",
            "timeout": 10,
            "statusMessage": "Checking Synapse inbox"
          }
        ]
      }
    ]
  }
}
