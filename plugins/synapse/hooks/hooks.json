{
  "description": "Route and reconcile Synapse messages while capturing durable session memory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/compact-memory.mjs",
            "timeout": 10,
            "statusMessage": "Preparing Synapse memory checkpoint"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/dispatch.mjs",
            "timeout": 10,
            "statusMessage": "Checking Synapse inbox"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/checkpoint-memory.mjs",
            "timeout": 10,
            "statusMessage": "Checking Synapse memory checkpoint"
          }
        ]
      }
    ]
  }
}
