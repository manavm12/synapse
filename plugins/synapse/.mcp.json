{
  "mcpServers": {
    "synapse-memory": {
      "command": "node",
      "args": ["./server/memory-mcp.mjs"],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH",
        "SYNAPSE_HOME",
        "SYNAPSE_HOST_DB",
        "SYNAPSE_MEMORY_DB",
        "SYNAPSE_MEMORY_ROOT"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 30
    }
  }
}
