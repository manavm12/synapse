{
  "name": "synapse",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "check": "biome check . && npm run test:coverage",
    "configure:plugin": "node scripts/configure-plugin.mjs",
    "install:plugin": "node scripts/install-local-plugin.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "memory:backfill": "node scripts/backfill-memory.mjs",
    "memory:status": "node src/server/worker/status-cli.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "start": "node src/server/index.mjs",
    "worker": "node src/server/worker/index.mjs",
    "worker:message-memory": "node src/server/message-memory/index.mjs",
    "worker:canary": "node src/server/worker/index.mjs --canary",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "synapse": "node src/client/cli.mjs",
    "test": "node --test",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=scripts/migrate.mjs --test-coverage-exclude=src/server/database.mjs --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=90",
    "test:sql": "node --test --test-concurrency=1 test/server/schema.test.mjs test/server/*-postgres.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13"
  }
}
