{
  "description": "Route queued Synapse messages through the desktop-owned project task.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/plugins/synapse/hooks/dispatch.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking Synapse inbox"
          }
        ]
      }
    ]
  }
}
